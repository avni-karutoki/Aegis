# ---- Aegis Backend (server/.env) ----
# Gemini: powers LIVE threat-verification verdicts through the Prune gateway.
# Without it the gateway runs in "deterministic guard" mode (fully functional demo).
GEMINI_API_KEY=""

# Model used for evaluations (defaults to gemini-2.0-flash)
GEMINI_MODEL="gemini-2.0-flash"

# Optional: external PRUNE AI Gateway (if you route calls to a hosted Prune
# instance instead of this project's built-in gateway middleware).
PRUNE_GATEWAY_URL=""
PRUNE_API_KEY=""

# Optional: external MARITIME Agent Orchestrator (federated mesh control plane).
MARITIME_API_URL=""
MARITIME_API_KEY=""

# Server
PORT=8787
