# GEMINI_API_KEY: Required for live Gemini evaluation calls routed through Prune.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional external Maritime Agent Orchestrator credentials
MARITIME_API_URL=""
MARITIME_API_KEY=""

# Optional external Prune AI Gateway credentials
PRUNE_GATEWAY_URL=""
PRUNE_API_KEY=""
