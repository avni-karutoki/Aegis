# ================= FRONTEND (Vite) =================
# Backend base URL the dashboard polls for live MARITIME / PRUNE telemetry.
# Leave unset to default to http://localhost:8787
VITE_API_URL="http://localhost:8787"

# ================= BACKEND (server/.env) =================
# GEMINI_API_KEY: powers LIVE threat-verification verdicts routed through
# the Prune gateway. Without it, the gateway runs in deterministic-guard
# mode (fully functional demo, zero API cost). On AI Studio this is
# injected automatically from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Model used for gateway evaluations
GEMINI_MODEL="gemini-2.0-flash"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional external Maritime Agent Orchestrator (federated mesh control plane)
MARITIME_API_URL=""
MARITIME_API_KEY=""

# Optional external Prune AI Gateway (hosted gateway instead of built-in)
PRUNE_GATEWAY_URL=""
PRUNE_API_KEY=""
